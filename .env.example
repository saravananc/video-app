# FAV environment configuration (FAV-103).
# Copy to .env.local (web) or export in your shell. Every variable is optional in
# development — missing keys activate the deterministic mock provider for that
# service, so the whole app runs end-to-end with zero external accounts.

# --- Core ---------------------------------------------------------------
# Managed Postgres (Neon). Unset = embedded PGlite under .data/ (dev only).
DATABASE_URL=
# Redis for rate limiting + caching. Unset = in-memory fallback (dev only).
REDIS_URL=
# Where PGlite + filesystem storage live in dev.
FAV_DATA_DIR=.data
# Set to 0 to disable auto-seeding the demo org on server start.
FAV_AUTO_SEED=1

# --- Auth (Clerk) -------------------------------------------------------
# Unset = local cookie-session auth with the seeded demo users.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Providers ----------------------------------------------------------
# Each provider var selects the adapter; unset = mock.
# LLM script generation: mock | anthropic | openai
FAV_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Visuals (images + text-to-video): mock | fal | replicate
FAV_VISUALS_PROVIDER=
FAL_KEY=
REPLICATE_API_TOKEN=

# Voiceover TTS: mock | elevenlabs
FAV_TTS_PROVIDER=
ELEVENLABS_API_KEY=

# Transcription (word timestamps): mock | openai-whisper
FAV_TRANSCRIPTION_PROVIDER=

# --- Storage & delivery -------------------------------------------------
# Object storage: unset = filesystem under FAV_DATA_DIR/storage (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Secret for signing local storage URLs in dev.
FAV_STORAGE_SIGNING_SECRET=dev-signing-secret

# Streaming host: unset = direct MP4 playback.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- Billing (Stripe) ---------------------------------------------------
# Unset = mock checkout that exercises the same webhook handler.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# --- Publishing OAuth ---------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Security -----------------------------------------------------------
# 32-byte hex key for envelope encryption of OAuth tokens / clone samples (FAV-1603).
FAV_ENCRYPTION_KEY=
# Secret for the local-session auth cookie in dev.
FAV_SESSION_SECRET=dev-session-secret

# --- Observability ------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
