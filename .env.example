# FAV environment configuration (FAV-103).
# Copy to .env.local (web) or export in your shell. Every variable is optional in
# development — missing keys activate the deterministic mock provider for that
# service, so the whole app runs end-to-end with zero external accounts.

# --- Core ---------------------------------------------------------------
# Managed Postgres (Neon). Unset = embedded PGlite under .data/ (dev only).
DATABASE_URL=
# Redis for rate limiting. REQUIRED in production: without it the limiter is
# per-process, so limits multiply by instance count and reset on every deploy.
REDIS_URL=
# Where PGlite + filesystem storage live in dev.
FAV_DATA_DIR=.data
# Set to 0 to disable auto-seeding the demo org on server start.
FAV_AUTO_SEED=1

# --- Providers ----------------------------------------------------------
# Each provider var selects the adapter; unset = mock.
# LLM script generation: mock | anthropic | openai
FAV_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Visuals (images + text-to-video): mock | fal | replicate
FAV_VISUALS_PROVIDER=
FAL_KEY=
REPLICATE_API_TOKEN=

# Voiceover TTS: mock | elevenlabs
FAV_TTS_PROVIDER=
ELEVENLABS_API_KEY=

# Transcription (word timestamps): mock | openai-whisper
FAV_TRANSCRIPTION_PROVIDER=

# Content moderation (FAV-1105): openai | keywords.
# Unset with OPENAI_API_KEY present = openai. Unset without it FAILS TO BOOT in
# production — keyword matching alone is not a content policy. Set
# FAV_MODERATION_PROVIDER=keywords to accept that trade-off deliberately.
FAV_MODERATION_PROVIDER=
# Score above which a non-bright-line category is flagged for review (0–1).
FAV_MODERATION_THRESHOLD=0.7

# --- Storage & delivery -------------------------------------------------
# Object storage: unset = filesystem under FAV_DATA_DIR/storage (dev only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Secret for signing local storage URLs in dev.
FAV_STORAGE_SIGNING_SECRET=dev-signing-secret

# Streaming host: unset = direct MP4 playback.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# --- Billing (Stripe) ---------------------------------------------------
# Unset = mock checkout that exercises the same webhook handler.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=

# --- Publishing OAuth ---------------------------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- Security -----------------------------------------------------------
# 32-byte hex key for envelope encryption of OAuth tokens / clone samples (FAV-1603).
FAV_ENCRYPTION_KEY=
# Secret for the local-session auth cookie in dev.
FAV_SESSION_SECRET=dev-session-secret

# --- Observability ------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# --- Autopilot & ops -----------------------------------------------------
# Set to 0 to disable the in-process autopilot scheduler (use external cron).
FAV_AUTOPILOT_SCHEDULER=1
# Webhook receiving ops alerts (queue backlog, provider outages, error spikes).
ALERT_WEBHOOK_URL=

# --- MCP server (apps/mcp) ----------------------------------------------
# Point an MCP client at apps/mcp with these set.
FAV_API_URL=http://localhost:3000
FAV_API_KEY=

# --- Job queue & workers (FAV-901/807) ----------------------------------
# Web tier: 0 to enqueue only, with apps/worker running as a separate pool.
FAV_EMBEDDED_WORKER=1
# Worker pool tuning.
FAV_WORKER_CONCURRENCY=2
FAV_WORKER_POLL_MS=2000
FAV_JOB_LEASE_MS=120000
# Set to 1 on exactly one worker replica to run autopilot + maintenance sweeps.
FAV_WORKER_SCHEDULERS=0
# Retention windows (days).
FAV_RETENTION_INTERMEDIATE_DAYS=7
FAV_RETENTION_SOFT_DELETED_DAYS=30

# --- Email (transactional) ----------------------------------------------
# Unset = console provider that logs messages (dev only — links appear in logs).
RESEND_API_KEY=
EMAIL_FROM=
# Escape hatch to boot production with development defaults. Never set this.
FAV_ALLOW_INSECURE_DEFAULTS=

# --- Observability (FAV-107/1601/1602) ----------------------------------
# Sentry error tracking. Unset = disabled entirely.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Required only to upload source maps at build time.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# PostHog product analytics. Unset = events logged, not sent.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# debug | info | warn | error
FAV_LOG_LEVEL=info

# --- Clerk (optional external auth, FAV-201) ----------------------------
# Unset = built-in email/password auth with the seeded demo users. Setting
# CLERK_SECRET_KEY hands identity to Clerk: the local password endpoints stop
# being consulted and the `__session` cookie becomes the only accepted session.
CLERK_SECRET_KEY=
# Read by edge middleware, which cannot see the secret key — set it too, or
# protected routes won't know Clerk is active.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Frontend API origin, e.g. https://clean-mammal-42.clerk.accounts.dev. Used to
# derive the JWKS URL and to pin the expected `iss` claim.
CLERK_ISSUER=
# Only needed if your JWKS lives somewhere other than $CLERK_ISSUER/.well-known/jwks.json
CLERK_JWKS_URL=
# Clerk's hosted sign-in/sign-up pages, where the login route sends people.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Verifies user.created / user.updated webhooks (svix signature).
CLERK_WEBHOOK_SECRET=
